{
  "name": "bialingo",
  "productName": "Bialingo",
  "version": "3.0.0",
  "description": "Bialingo : langues, maths, échecs et musique. Gratuit, hors ligne, sans publicité.",
  "main": "main.js",
  "homepage": "https://github.com/Bianca23-cloud/Bialingo",
  "author": { "name": "Bialingo", "email": "bialingo@users.noreply.github.com" },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.bianca23cloud.bialingo",
    "productName": "Bialingo",
    "files": ["main.js", "app/**"],
    "icon": "app/icon.png",
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Bialingo", "artifactName": "Bialingo-Windows-Setup.${ext}" },
    "portable": { "artifactName": "Bialingo-Windows-portable.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "category": "Education", "maintainer": "Bialingo <bialingo@users.noreply.github.com>", "artifactName": "Bialingo-Linux.${ext}" }
  }
}
